# WashBoard — variables d'environnement
# Copier en .env.local et renseigner les valeurs. NE JAMAIS committer .env.local.
# Même liste à renseigner dans Vercel (Settings → Environment Variables), sauf
# la section « Tests » tout en bas.

# ── Supabase ───────────────────────────────────────────────────────────────
# URL et clés du projet Supabase (Dashboard Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role (SECRET, jamais exposée au client — usage serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=

# ── Application ────────────────────────────────────────────────────────────
# URL publique de l'app (ex. http://localhost:3000 en local, https://www.washboard.fr en prod)
NEXT_PUBLIC_APP_URL=

# ── Emails (Resend) ────────────────────────────────────────────────────────
# Clé API Resend (envoi des emails : réservation, reçu, avis Google...)
RESEND_API_KEY=

# ── SMS (Brevo) ────────────────────────────────────────────────────────────
# Clé API Brevo (avis Google et relances clients envoyés par SMS)
BREVO_API_KEY=

# ── Google Maps (zones, distances, frais de déplacement) ───────────────────
# Clé serveur uniquement — surtout PAS de préfixe NEXT_PUBLIC_, qui la ferait
# inliner dans le bundle navigateur si elle était référencée côté client.
# (L'ancien nom NEXT_PUBLIC_GOOGLE_MAPS_API_KEY n'est plus lu que par /api/health,
# pour signaler qu'il traîne encore : il peut être supprimé.)
GOOGLE_MAPS_API_KEY=

# ── Google Calendar (OAuth — synchro agenda du laveur) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback OAuth (ex. https://www.washboard.fr/api/auth/google-calendar/callback)
GOOGLE_REDIRECT_URI=
# Clé du compte de service Google (JSON), si utilisé pour l'accès agenda
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Cron (tâches planifiées : purge comptes, envoi des avis) ───────────────
# Secret partagé pour protéger les routes /api/cron/* (Vercel Cron / cron-job.org)
CRON_SECRET=

# ── Stripe (paiement abonnement) ───────────────────────────────────────────
# Clé secrète (Dashboard Stripe → Développeurs → Clés API)
STRIPE_SECRET_KEY=
# Secret du webhook (Dashboard Stripe → Développeurs → Webhooks → endpoint)
STRIPE_WEBHOOK_SECRET=
# Price IDs des 2 formules (Dashboard Stripe → Catalogue de produits → tarif → ID).
# La formule Business a été retirée le 2026-08-26 : STRIPE_PRICE_ID_BUSINESS n'est
# plus lue et peut être supprimée de Vercel.
STRIPE_PRICE_ID_ESSENTIEL=
STRIPE_PRICE_ID_PRO=

# ── Notifications sur téléphone (web push) ─────────────────────────────────
# Sans ces deux clés, le bouton « Recevoir mes réservations en notification »
# répond « Les notifications ne sont pas configurées sur ce site ».
# Générer une paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Équipe support ─────────────────────────────────────────────────────────
# Emails de l'équipe, séparés par des virgules : accès à la page Support
# (connexion temporaire au compte d'un laveur, avec son accord) et notification
# de l'équipe à chaque nouvelle inscription.
SUPPORT_ADMIN_EMAILS=

# ── Inscription ────────────────────────────────────────────────────────────
# Facultatif. Numéros exemptés de la règle « un numéro = un compte », séparés
# par des virgules (tests sur son propre numéro). Jamais dans le dépôt : il est public.
PHONE_UNIQUENESS_EXEMPT=

# ── Alertes d'erreur (Sentry) ───────────────────────────────────────────────
# Facultatif. Sans ces variables, l'intégration reste éteinte et le site
# fonctionne exactement comme avant (voir sentry.server.config.ts). Une fois
# un compte Sentry créé (projet Next.js), coller le DSN ci-dessous — c'est la
# seule variable nécessaire pour recevoir des alertes.
NEXT_PUBLIC_SENTRY_DSN=
# Les trois suivantes ne servent qu'à l'envoi des source maps (stack traces en
# code source plutôt qu'en code minifié) : facultatives, à ajouter plus tard.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Tests (local et CI uniquement) ─────────────────────────────────────────
# ⚠️ NE JAMAIS définir sur Vercel : en production, cette variable autoriserait
# n'importe qui à effacer les données « [E2E] » du site en ligne.
# E2E_CLEANUP_ENABLED=

exports[`sendSupportReply > verrou 3 — le contenu ne dépend que du titre et du lien, et il est figé 1`] = `
"<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light">
<title>Nouvelle réponse</title>
<!--[if !mso]><!--><link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&display=swap" rel="stylesheet"><!--<![endif]-->
<style>
:root{color-scheme:light only;supported-color-schemes:light}
body{margin:0;padding:0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
a{color:#306090}
@media (max-width:480px){
.wb-marge{padding:20px 12px 28px!important}
.wb-carte{padding:28px 20px!important}
.wb-titre{font-size:24px!important}
.wb-col{display:block!important;width:100%!important;padding:0 0 16px!important;border:0!important}
.wb-bouton{width:100%!important}
.wb-bouton a{display:block!important;text-align:center!important}
}
</style>
<!--[if mso]><style>body,table,td,p,a,h1,div,span,li{font-family:Arial,Helvetica,sans-serif!important}</style><![endif]-->
</head>
<body style="margin:0;padding:0;background:#F6F5F3;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;background:#F6F5F3;">
<tr><td align="center" class="wb-marge" style="padding:32px 16px 40px;">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;max-width:600px;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#16161A;">
<tr><td style="padding:0 4px 16px;text-align:left;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;"><tr>
<td style="vertical-align:middle;padding-right:10px;"><img src="https://app.test/logo-washboard-128.png" width="28" height="28" alt="" style="display:block;border:0;border-radius:7px;"></td>
<td style="vertical-align:middle;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;letter-spacing:-0.01em;color:#16161A;">WashBoard</td>
</tr></table></td></tr>
<tr><td class="wb-carte" style="background:#FFFFFF;border:1px solid #E8E8E9;border-radius:16px;padding:36px 40px;text-align:left;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#16161A;">

<img src="https://app.test/email/bulle.png" width="44" height="44" alt="" style="display:block;border:0;margin:0 0 18px;">
<h1 class="wb-titre" style="margin:0 0 8px;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:27px;line-height:1.12;font-weight:700;letter-spacing:-0.025em;font-stretch:108%;color:#16161A;">Nouvelle réponse</h1>
<p style="margin:0 0 24px;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;color:#6B6B76;">L&apos;équipe WashBoard a répondu à votre question</p>
<p style="margin:0 0 24px;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#6B6B76;">À propos de : <strong style="color:#16161A;">{TITRE}</strong></p>
<table role="presentation" class="wb-bouton" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;margin:0;"><tr>
<td align="center" style="border-radius:13px;background:#306090;"><a href="https://app.test/dashboard/assistance?fil={ID}" target="_blank" style="display:inline-block;padding:15px 26px;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;line-height:1.2;color:#FFFFFF;text-decoration:none;border-radius:13px;">Voir la réponse →</a></td>
</tr></table>
<p style="margin:16px 0 0;font-family:'Archivo',-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12.5px;line-height:1.6;color:#6E6E78;">Connectez-vous à votre tableau de bord pour la lire.</p>
</td></tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</body>
</html>"
`;
